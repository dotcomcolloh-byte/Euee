# Telefam Backend & Auth Configuration
# Configure secrets in the AI Studio Secrets panel or local .env (never commit .env).

# Public backend base URL (HTTPS in production)
TELEFAM_API_BASE_URL=https://api.telefam.company

# Google OAuth 2.0 Web Client ID for Credential Manager Sign in with Google
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID

# Optional SHA-256 SPKI TLS pin for api.telefam.company (format: sha256/<base64>, or NONE)
TELEFAM_TLS_PIN_SHA256=NONE

# Telefam Ktor Backend Environment Variables
# Copy to .env and fill real production secrets before deploying.

PORT=8080
TELEFAM_ENV=production
PUBLIC_BASE_URL=https://api.telefam.company

# PostgreSQL 16 Connection
DATABASE_URL=jdbc:postgresql://postgres:5432/telefam
DB_USER=telefam_app
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Resend Email API (OTP Delivery)
RESEND_API_KEY=re_CHANGE_ME
RESEND_FROM_EMAIL=Telefam <noreply@telefam.company>

# Google OAuth 2.0 Web Client ID (must match Android/Desktop GOOGLE_WEB_CLIENT_ID)
GOOGLE_WEB_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com

# Sign in with Apple Bundle ID(s) / Service ID (comma-separated)
APPLE_BUNDLE_IDS=com.telefam.company.app

# Cryptographic Keys (32+ random bytes Base64)
JWT_HMAC_SECRET=CHANGE_ME_BASE64_32_BYTES
DATA_ENCRYPTION_KEY_B64=CHANGE_ME_BASE64_32_BYTES
DEVICE_BINDING_PEPPER=CHANGE_ME_BASE64_32_BYTES

# Offline Media Sandbox Unix Socket & Encrypted Avatar Storage
SANDBOX_SOCKET_PATH=/run/sandbox/processor.sock
AVATAR_STORAGE_DIR=/var/lib/telefam/avatars
